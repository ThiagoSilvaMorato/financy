// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]

  resetCode       String?
  resetCodeExpiry DateTime?

  // Ambientes compartilhados
  environmentMemberships EnvironmentMember[]
  createdInviteCodes     EnvironmentInviteCode[]

  createdInstallmentPurchases InstallmentPurchase[]

  // Ambiente usado por padrão no login. Nulo (ou apontando para um ambiente ao qual o usuário
  // perdeu acesso) cai de volta no ambiente pessoal — ver EnvironmentService.
  defaultEnvironmentId String?
  defaultEnvironment   Environment? @relation("UserDefaultEnvironment", fields: [defaultEnvironmentId], references: [id], onDelete: SetNull)
}

// "pending" é uma terceira permissão real (não um estado de convite): quem entra por código de
// convite (EnvironmentInviteCode) começa como "pending" e só vê os próprios dados de identidade
// até um Admin aprovar (EnvironmentService.approveMember), nunca Category/Transaction do ambiente
// — ver assertEnvironmentAccess (bloqueia pending) vs. assertEnvironmentMember (permite pending).
enum EnvironmentRole {
  admin
  user
  pending
}

model Environment {
  id         String   @id @default(uuid())
  name       String
  isPersonal Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  members      EnvironmentMember[]
  inviteCode   EnvironmentInviteCode?
  categories   Category[]
  transactions Transaction[]
  installmentPurchases InstallmentPurchase[]

  defaultForUsers User[] @relation("UserDefaultEnvironment")
}

// Membro real (userId preenchido, pode logar e atua conforme `role`) ou participante sem login
// (userId nulo, só existe para atribuição de transações via `displayName`). "É participante?"
// deve ser sempre derivado de `userId === null` em todo o código — nunca a partir de `role`.
//
// Exatamente um entre `userId`/`displayName` deve estar preenchido. Prisma não oferece `@@check`
// declarativo nesta versão, então essa invariante é garantida centralizadamente no
// EnvironmentService — qualquer escrita direta via `prismaClient.environmentMember` fora do
// service pula essa validação.
//
// Saída/remoção (de membro ou participante) nunca apaga a linha, só marca `removedAt` — apagar
// quebraria `Transaction.memberId` (histórico financeiro de quem já saiu do ambiente).
model EnvironmentMember {
  id            String           @id @default(uuid())
  environmentId String
  environment   Environment      @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          EnvironmentRole?
  displayName   String?
  joinedAt      DateTime         @default(now())
  removedAt     DateTime?

  transactions Transaction[]
  installmentPurchases InstallmentPurchase[]

  // Vale sobre a tabela inteira (ativos e soft-deletados); Postgres trata múltiplos NULL como
  // distintos, então não afeta participantes. Reentrada após saída reaproveita a linha antiga
  // (ver EnvironmentService.joinEnvironmentByCode) em vez de tentar um create que violaria isso.
  @@unique([environmentId, userId])
}

// Código de convite reutilizável por ambiente (substitui o convite por e-mail da tarefa 01).
// environmentId como chave primária garante no máximo 1 código ativo por ambiente — gerar um novo
// é um upsert que substitui code/expiresAt/createdByUserId na mesma linha (EnvironmentService.
// generateEnvironmentInviteCode), nunca cria uma segunda. "code" é único globalmente.
model EnvironmentInviteCode {
  environmentId   String      @id
  environment     Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  code            String      @unique
  createdByUserId String
  createdByUser   User        @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
}

model Category {
  id                String        @id @default(uuid())
  title             String
  description       String?
  icon              String
  color             String
  environmentId     String
  environment       Environment   @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  transactions      Transaction[]
  transactionsCount Int           @default(0)
  totalAmount       String        @default("0")
  installmentPurchases InstallmentPurchase[]

  @@unique([environmentId, title])
}

enum TransactionType {
  income
  expense
}

model Transaction {
  id            String            @id @default(uuid())
  type          TransactionType
  description   String?
  date          DateTime
  amount        String
  categoryId    String
  category      Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  environmentId String
  environment   Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  // Quem efetivamente lançou a transação (auditoria).
  createdBy     String
  createdByUser User              @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  // A quem a transação é atribuída: o próprio criador, outro membro real ou um participante sem
  // login. Precisa pertencer ao mesmo environmentId da transação — validado no TransactionService,
  // a FK por si só não garante isso. onDelete: Restrict (nunca cascade destrutivo) porque saída/
  // remoção de EnvironmentMember é sempre soft delete — essa FK nunca deveria ver uma deleção real
  // fora do fluxo controlado de exclusão de ambiente inteiro (EnvironmentService.deleteEnvironment,
  // que apaga Transaction antes de EnvironmentMember, na mesma $transaction).
  memberId      String
  member        EnvironmentMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Preenchido quando esta transação é uma parcela gerada por createInstallmentPurchase (pagamento
  // em crédito); null significa transação normal (Débito), o que já existe hoje. onDelete: SetNull
  // (nunca Cascade/Restrict): se o InstallmentPurchase for apagado por qualquer motivo, a transação
  // em si — histórico financeiro real — nunca deveria desaparecer, só perder o metadado de
  // agrupamento. installmentNumber é só metadado (posição 1-based da parcela); a descrição
  // formatada ("5/12") já é gravada direto em `description` na criação, não calculada depois.
  installmentPurchaseId String?
  installmentPurchase   InstallmentPurchase? @relation(fields: [installmentPurchaseId], references: [id], onDelete: SetNull)
  installmentNumber     Int?

  // índices úteis
  @@index([date])
  @@index([environmentId])
  @@index([memberId])
}

// Agrupador/"recibo" de uma compra parcelada em N transações mensais (pagamento em crédito).
// totalAmount/installmentAmount são calculados e persistidos no momento da criação (não
// recalculados depois), pra sempre bater com o que de fato foi gerado, mesmo que no futuro alguém
// edite uma parcela individual isolada. memberId com onDelete: Restrict: nunca deveria sofrer um
// delete físico fora de um fluxo controlado — não existe fluxo de exclusão do InstallmentPurchase
// nesta tarefa, então Restrict é só uma salvaguarda (ver deleteCategory/deleteEnvironment, que
// apagam InstallmentPurchase explicitamente antes de poder violar essa restrição).
model InstallmentPurchase {
  id                String          @id @default(uuid())
  description       String
  type              TransactionType
  totalAmount       String
  installmentAmount String
  installmentsCount Int
  startDate         DateTime
  categoryId        String
  category          Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  environmentId     String
  environment       Environment       @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  memberId          String
  member            EnvironmentMember @relation(fields: [memberId], references: [id], onDelete: Restrict)
  createdByUserId   String
  createdByUser     User              @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  transactions      Transaction[]
  createdAt         DateTime          @default(now())
}
